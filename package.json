{
  "name": "herdr-gentle-shell",
  "version": "1.6.1",
  "description": "Pi package for Herdr sidebar states: the Pi extension sidecar that publishes session facts as Herdr pane-metadata tokens, the optional Moshi notification channel, and the Pi-side helpers the Herdr Gentle Shell plugin drives.",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "moshi"
  ],
  "homepage": "https://github.com/jonasotoaguilar/herdr-gentle-shell#readme",
  "bugs": {
    "url": "https://github.com/jonasotoaguilar/herdr-gentle-shell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasotoaguilar/herdr-gentle-shell.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "bin",
    "lib",
    "docs",
    "README.md",
    "DESIGN.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/gentle-herdr-state.ts",
      "./extensions/herdr-session-open.ts"
    ]
  }
}
