#!/bin/sh
# release-verify: confirm the per-package release for RELEASE_TAG exists and
# is sane after publish. Read-only; makes no changes.
#
# Tag series (exactly two, strict semver, no prerelease or build metadata):
#   pi-vX.Y.Z     verifies the GitHub Release and additionally verifies the
#                 published npm version resolves: npm view --prefer-online
#                 herdr-gentle-shell@<version> version equals <version>. The
#                 probe is a bounded wait rather than a single read, because
#                 npm returns from a publish before the version is readable
#                 ("Your package is being processed and may take a few minutes
#                 to become available"). While the registry does not serve the
#                 version yet, the probe waits
#                 RELEASE_NPM_PROBE_DELAY_SECONDS and probes again, up to
#                 RELEASE_NPM_PROBE_ATTEMPTS probes in total; only then does it
#                 fail closed, so a genuinely missing publish is still a red
#                 release. --prefer-online makes every probe revalidate against
#                 the registry instead of trusting a cached negative answer, so
#                 the wait cannot be satisfied by stale local data either.
#   herdr-vX.Y.Z  verifies the GitHub Release only; never contacts npm. The
#                 bare v* series is rejected.
#
# Fails when the release is a draft or a prerelease, since neither is a
# published release. The release carries the tag and its notes only: no asset
# is downloaded or checked, because the repository ships no install script.
# The shared gate for both series is the published GitHub Release; the pi
# series additionally gates on the npm version above. (The workflow's
# pi-series npm publish step authenticates with trusted publishing (OIDC) and
# holds no npm token, in the workflow or in the `release` environment; this
# script's npm view check itself needs no token either, and its GH_TOKEN is
# GitHub's, not npm's.)
#
# Environment (set by release.yml):
#   RELEASE_TAG         tag to verify, e.g. pi-v0.1.0 or herdr-v0.1.0
#                         (required, strict pi-vX.Y.Z / herdr-vX.Y.Z)
#   RELEASE_REPOSITORY  owner/repo (optional; defaults to the gh-resolved repo)
#   GH_TOKEN            auth token for gh (required, via environment only)
#   RELEASE_NPM_PROBE_ATTEMPTS
#                       pi series only: total npm view probes allowed before the
#                       check fails closed (optional, default 8; a positive
#                       integer)
#   RELEASE_NPM_PROBE_DELAY_SECONDS
#                       pi series only: seconds to wait between probes
#                       (optional, default 15; a non-negative integer, so a test
#                       can exercise the retry without the production wait)

set -eu

fail() {
  printf 'release-verify: error: %s\n' "$1" >&2
  exit 1
}

pass() {
  printf 'release-verify: %s\n' "$1"
}

TAG="${RELEASE_TAG:-}"
[ -n "$TAG" ] || fail "RELEASE_TAG is required (e.g. RELEASE_TAG=pi-v0.1.0)"

if ! printf '%s' "$TAG" | grep -Eq '^(pi-v|herdr-v)[0-9]+\.[0-9]+\.[0-9]+$'; then
  fail "RELEASE_TAG must be pi-vX.Y.Z or herdr-vX.Y.Z (strict semver, no prerelease or build metadata), got '$TAG'"
fi

command -v gh >/dev/null 2>&1 || fail "gh CLI is required"
[ -n "${GH_TOKEN:-}" ] || fail "GH_TOKEN is required in the environment"

VERIFY_TMPDIR="$(mktemp -d)" || fail "mktemp failed"
trap 'rm -rf "$VERIFY_TMPDIR"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

VIEW_ERR="$VERIFY_TMPDIR/view.err"
VIEW_STATUS=0
VIEW=""
if [ -n "${RELEASE_REPOSITORY:-}" ]; then
  if VIEW="$(gh release view "$TAG" --repo "$RELEASE_REPOSITORY" --json tagName,isDraft,isPrerelease 2>"$VIEW_ERR")"; then
    VIEW_STATUS=0
  else
    VIEW_STATUS=$?
  fi
else
  if VIEW="$(gh release view "$TAG" --json tagName,isDraft,isPrerelease 2>"$VIEW_ERR")"; then
    VIEW_STATUS=0
  else
    VIEW_STATUS=$?
  fi
fi
if [ "$VIEW_STATUS" -ne 0 ]; then
  if [ "$VIEW_STATUS" -eq 1 ] && grep -q "release not found" "$VIEW_ERR" 2>/dev/null; then
    if [ -n "${RELEASE_REPOSITORY:-}" ]; then
      fail "release $TAG not found in $RELEASE_REPOSITORY"
    else
      fail "release $TAG not found"
    fi
  else
    VIEW_DETAIL="$(cat "$VIEW_ERR" 2>/dev/null || true)"
    [ -n "$VIEW_DETAIL" ] || VIEW_DETAIL="exit $VIEW_STATUS"
    fail "gh release view $TAG failed ($VIEW_DETAIL)"
  fi
fi
[ -n "$VIEW" ] || fail "gh release view $TAG failed (empty response)"

printf '%s\n' "$VIEW"
TAG_NAME="$(printf '%s' "$VIEW" | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(JSON.parse(d).tagName))")"
[ "$TAG_NAME" = "$TAG" ] || fail "release tag mismatch: expected $TAG, got $TAG_NAME"

IS_DRAFT="$(printf '%s' "$VIEW" | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(JSON.parse(d).isDraft))")"
[ "$IS_DRAFT" = "false" ] || fail "release $TAG is a draft; it is not published"

IS_PRERELEASE="$(printf '%s' "$VIEW" | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(JSON.parse(d).isPrerelease))")"
[ "$IS_PRERELEASE" = "false" ] || fail "release $TAG is a prerelease; it is not published"

case "$TAG" in
  pi-v*)
    command -v npm >/dev/null 2>&1 || fail "npm is required"
    NPM_VERSION="$(printf '%s' "$TAG" | sed 's/^pi-v//')"
    PROBE_ATTEMPTS="${RELEASE_NPM_PROBE_ATTEMPTS:-8}"
    PROBE_DELAY="${RELEASE_NPM_PROBE_DELAY_SECONDS:-15}"
    printf '%s' "$PROBE_ATTEMPTS" | grep -Eq '^[1-9][0-9]*$' \
      || fail "RELEASE_NPM_PROBE_ATTEMPTS must be a positive integer, got '$PROBE_ATTEMPTS'"
    printf '%s' "$PROBE_DELAY" | grep -Eq '^[0-9]+$' \
      || fail "RELEASE_NPM_PROBE_DELAY_SECONDS must be a non-negative integer, got '$PROBE_DELAY'"
    PROBE_ATTEMPT=1
    PUBLISHED=""
    while :; do
      if PUBLISHED="$(npm view --prefer-online "herdr-gentle-shell@$NPM_VERSION" version)"; then
        break
      fi
      [ "$PROBE_ATTEMPT" -lt "$PROBE_ATTEMPTS" ] \
        || fail "npm view herdr-gentle-shell@$NPM_VERSION version failed"
      printf 'release-verify: npm does not serve herdr-gentle-shell@%s yet; waiting for registry propagation (attempt %s of %s, retrying in %ss)\n' \
        "$NPM_VERSION" "$PROBE_ATTEMPT" "$PROBE_ATTEMPTS" "$PROBE_DELAY"
      sleep "$PROBE_DELAY"
      PROBE_ATTEMPT=$((PROBE_ATTEMPT + 1))
    done
    PUBLISHED_TRIMMED="$(printf '%s' "$PUBLISHED" | tr -d '[:space:]')"
    [ "$PUBLISHED_TRIMMED" = "$NPM_VERSION" ] \
      || fail "npm version mismatch for $TAG: registry has '$PUBLISHED_TRIMMED', expected '$NPM_VERSION'"
    pass "npm version OK: herdr-gentle-shell@$PUBLISHED_TRIMMED"
    ;;
esac

rm -rf "$VERIFY_TMPDIR"
trap - EXIT INT TERM

pass "verified GitHub Release $TAG"
