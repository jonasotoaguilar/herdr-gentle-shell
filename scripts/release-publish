#!/bin/sh
# release-publish: create the GitHub Release for RELEASE_TAG.
#
# Tag series (exactly two, strict semver, no prerelease or build metadata):
#   pi-vX.Y.Z     the Pi package release (npm publish for the Pi package
#                 happens separately in the workflow; this script creates the
#                 GitHub Release).
#   herdr-vX.Y.Z  the Herdr plugin release (GitHub Release only). The bare v*
#                 series is rejected.
#
# Shared gate: both series create the GitHub Release with
# `gh release create --generate-notes` and nothing attached — the repository
# ships no install script, so a release carries the tag and its notes. Base
# notes are curated afterwards by editing the published release in place.
# No npm publishing, no registry uploads, no asset builds here: the pi-series
# npm publish lives in the workflow and authenticates with trusted publishing
# (OIDC) — no npm token exists anywhere, in the workflow or in the `release`
# environment — and never runs on a herdr-v tag.
#
# Repair path: when a release for the tag already exists and is a draft, only
# the release is deleted (`gh release delete --yes`, never --cleanup-tag so
# the pushed tag survives) and recreated. A published release keeps refusing
# to overwrite.
#
# Environment (set by release.yml):
#   RELEASE_TAG         tag to publish, e.g. pi-v0.1.0 or herdr-v0.1.0
#                         (required, strict pi-vX.Y.Z / herdr-vX.Y.Z)
#   RELEASE_COMMIT      commit the release targets (required)
#   RELEASE_REPOSITORY  owner/repo (optional; defaults to the gh-resolved repo)
#   GH_TOKEN            auth token for gh (required, via environment only)
#
# Refuses to overwrite an existing published release for the tag.

set -eu

fail() {
  printf 'release-publish: error: %s\n' "$1" >&2
  exit 1
}

pass() {
  printf 'release-publish: %s\n' "$1"
}

TAG="${RELEASE_TAG:-}"
[ -n "$TAG" ] || fail "RELEASE_TAG is required (e.g. RELEASE_TAG=pi-v0.1.0)"

if ! printf '%s' "$TAG" | grep -Eq '^(pi-v|herdr-v)[0-9]+\.[0-9]+\.[0-9]+$'; then
  fail "RELEASE_TAG must be pi-vX.Y.Z or herdr-vX.Y.Z (strict semver, no prerelease or build metadata), got '$TAG'"
fi

COMMIT="${RELEASE_COMMIT:-}"
[ -n "$COMMIT" ] || fail "RELEASE_COMMIT is required"

command -v gh >/dev/null 2>&1 || fail "gh CLI is required"
[ -n "${GH_TOKEN:-}" ] || fail "GH_TOKEN is required in the environment"

WORK_TMPDIR="$(mktemp -d)" || fail "mktemp failed"
trap 'rm -rf "$WORK_TMPDIR"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

VIEW_ERR="$WORK_TMPDIR/view.err"
VIEW_STATUS=0
VIEW=""
if [ -n "${RELEASE_REPOSITORY:-}" ]; then
  if VIEW="$(gh release view "$TAG" --repo "$RELEASE_REPOSITORY" --json isDraft 2>"$VIEW_ERR")"; then
    VIEW_STATUS=0
  else
    VIEW_STATUS=$?
  fi
else
  if VIEW="$(gh release view "$TAG" --json isDraft 2>"$VIEW_ERR")"; then
    VIEW_STATUS=0
  else
    VIEW_STATUS=$?
  fi
fi
if [ "$VIEW_STATUS" -eq 0 ]; then
  [ -n "$VIEW" ] || fail "gh release view $TAG failed (empty response)"
  case "$VIEW" in
    *'"isDraft":true'*|*'"isDraft": true'*)
      if [ -n "${RELEASE_REPOSITORY:-}" ]; then
        pass "deleting draft release $TAG in $RELEASE_REPOSITORY"
        gh release delete "$TAG" --repo "$RELEASE_REPOSITORY" --yes \
          || fail "deleting draft release $TAG failed"
      else
        pass "deleting draft release $TAG"
        gh release delete "$TAG" --yes \
          || fail "deleting draft release $TAG failed"
      fi
      ;;
    *)
      if [ -n "${RELEASE_REPOSITORY:-}" ]; then
        fail "release $TAG already exists in $RELEASE_REPOSITORY; refusing to overwrite"
      else
        fail "release $TAG already exists; refusing to overwrite"
      fi
      ;;
  esac
elif [ "$VIEW_STATUS" -eq 1 ] && grep -q "release not found" "$VIEW_ERR" 2>/dev/null; then
  : # genuine absence: proceed to create
else
  VIEW_DETAIL="$(cat "$VIEW_ERR" 2>/dev/null || true)"
  [ -n "$VIEW_DETAIL" ] || VIEW_DETAIL="exit $VIEW_STATUS"
  fail "gh release view $TAG failed ($VIEW_DETAIL)"
fi

pass "creating GitHub Release $TAG targeting $COMMIT"
if [ -n "${RELEASE_REPOSITORY:-}" ]; then
  gh release create "$TAG" \
    --repo "$RELEASE_REPOSITORY" \
    --target "$COMMIT" \
    --title "$TAG" \
    --generate-notes \
    || fail "creating GitHub Release $TAG failed"
else
  gh release create "$TAG" \
    --target "$COMMIT" \
    --title "$TAG" \
    --generate-notes \
    || fail "creating GitHub Release $TAG failed"
fi

rm -rf "$WORK_TMPDIR"
trap - EXIT INT TERM

pass "published GitHub Release $TAG"
